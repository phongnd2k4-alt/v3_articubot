<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===================================== -->
    <!-- GAZEBO CLASSIC - AGV 4 BANH          -->
    <!-- ===================================== -->

    <gazebo>
        <plugin
            name="agv_diff_drive"
            filename="libgazebo_ros_diff_drive.so">

            <ros>
                <namespace>/</namespace>
            </ros>

            <update_rate>50</update_rate>

            <!-- 2 cap banh: truoc va sau -->
            <num_wheel_pairs>2</num_wheel_pairs>

            <!-- Cap banh truoc -->
            <left_joint>lf_wheel_joint</left_joint>
            <right_joint>rf_wheel_joint</right_joint>

            <!-- Cap banh sau -->
            <left_joint>lr_wheel_joint</left_joint>
            <right_joint>rr_wheel_joint</right_joint>

            <!-- Khoang cach giua banh trai va phai -->
            <wheel_separation>0.38</wheel_separation>
            <wheel_separation>0.38</wheel_separation>

            <!-- Duong kinh banh -->
            <wheel_diameter>0.13</wheel_diameter>
            <wheel_diameter>0.13</wheel_diameter>

            <!-- Luc va gia toc banh -->
            <max_wheel_torque>15</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>

            <!-- Topic dieu khien -->
            <command_topic>cmd_vel</command_topic>

            <!-- Odometry -->
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>

            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>

            <!-- robot_state_publisher xu ly TF cua banh -->
            <publish_wheel_tf>false</publish_wheel_tf>

        </plugin>
    </gazebo>


    <!-- ===================================== -->
    <!-- GAZEBO JOINT STATE PUBLISHER         -->
    <!-- ===================================== -->

    <gazebo>
        <plugin
            name="agv_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">

            <ros>
                <namespace>/</namespace>
            </ros>

            <update_rate>30</update_rate>

            <joint_name>lf_wheel_joint</joint_name>
            <joint_name>rf_wheel_joint</joint_name>
            <joint_name>lr_wheel_joint</joint_name>
            <joint_name>rr_wheel_joint</joint_name>

        </plugin>
    </gazebo>


    <!-- ===================================== -->
    <!-- WHEEL FRICTION                       -->
    <!-- ===================================== -->

    <gazebo reference="lf_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="rf_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="lr_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="rr_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

</robot>