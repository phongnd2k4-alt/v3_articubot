<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv">

  <!-- ==================== MATERIALS ==================== -->
  <material name="blue">
    <color rgba="0.1 0.25 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==================== BASE LINK ==================== -->
  <!--
       Gom cac thanh khung duoi va 4 tru vao base_link.
       Khong tao rieng lower_rail, lower_cross hoac support_post.
       Hinh dang khung va tru van duoc giu bang cac khoi box.
  -->

  <link name="base_link">

    <!-- Tam san duoi -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.34 0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.34 0.025"/>
      </geometry>
    </collision>

    <!-- Thanh khung duoi ben trai -->
    <visual>
      <origin xyz="0 0.13 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.025 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0.13 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.025 0.025"/>
      </geometry>
    </collision>

    <!-- Thanh khung duoi ben phai -->
    <visual>
      <origin xyz="0 -0.13 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.025 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 -0.13 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.025 0.025"/>
      </geometry>
    </collision>

    <!-- Thanh ngang khung duoi phia truoc -->
    <visual>
      <origin xyz="0.17 0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.34 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.17 0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.34 0.025"/>
      </geometry>
    </collision>

    <!-- Thanh ngang khung duoi phia sau -->
    <visual>
      <origin xyz="-0.17 0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.34 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="-0.17 0 -0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.34 0.025"/>
      </geometry>
    </collision>

    <!-- Tru dung goc truoc ben trai -->
    <visual>
      <origin xyz="0.17 0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.17 0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
    </collision>

    <!-- Tru dung goc truoc ben phai -->
    <visual>
      <origin xyz="0.17 -0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.17 -0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
    </collision>

    <!-- Tru dung goc sau ben trai -->
    <visual>
      <origin xyz="-0.17 0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="-0.17 0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
    </collision>

    <!-- Tru dung goc sau ben phai -->
    <visual>
      <origin xyz="-0.17 -0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="-0.17 -0.13 0.1025" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.18"/>
      </geometry>
    </collision>

    <!-- Khoi luong va mo-men quan tinh cua khung duoi -->
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="5.6"/>
      <inertia
        ixx="0.055"
        ixy="0.0"
        ixz="0.0"
        iyy="0.075"
        iyz="0.0"
        izz="0.12"/>
    </inertial>

  </link>

  <!-- ==================== UPPER DECK ==================== -->
  <!-- San tren duoc giu thanh mot link rieng -->

  <link name="upper_deck">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.34 0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.34 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.019"
        ixy="0.0"
        ixz="0.0"
        iyy="0.031"
        iyz="0.0"
        izz="0.045"/>
    </inertial>

  </link>

  <!-- Gan san tren vao khung duoi -->
  <joint name="upper_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_deck"/>
    <origin xyz="0 0 0.205" rpy="0 0 0"/>
  </joint>

  <!-- ==================== WHEEL MACRO ==================== -->
  <!--
    Moi link banh co truc Z huong ra ngoai:
      - Banh trai: truc Z local huong +Y cua robot.
      - Banh phai: truc Z local huong -Y cua robot.
    Truc quay vat ly cua ca 4 banh van cung huong +Y trong he toa do robot,
    de lenh tien cua differential-drive lam xe chay thang.
  -->

  <xacro:macro name="wheel" params="name x y side">

    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.045"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.065" length="0.045"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.0012"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0012"
          iyz="0.0"
          izz="0.0012"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} -0.065"
              rpy="${side == 'left' and '-1.57079632679' or '1.57079632679'} 0 0"/>
      <axis xyz="0 0 ${side == 'left' and '1' or '-1'}"/>
    </joint>

  </xacro:macro>

  <!-- 4 banh: z local huong ra ngoai, truc quay vat ly cung huong +Y -->
  <xacro:wheel name="lf" x="0.14" y="0.19" side="left"/>
  <xacro:wheel name="rf" x="0.14" y="-0.19" side="right"/>
  <xacro:wheel name="lr" x="-0.14" y="0.19" side="left"/>
  <xacro:wheel name="rr" x="-0.14" y="-0.19" side="right"/>

</robot>