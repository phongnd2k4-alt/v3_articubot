<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================== -->
  <!-- RASPBERRY PI CAMERA OV5647 - 5MP                   -->
  <!-- Board: approximately 25 x 24 mm                    -->
  <!-- Diagonal FOV: 160 degrees                          -->
  <!-- Simulated output: 1920 x 1080                      -->
  <!-- ================================================== -->

  <!-- Gan camera tren san tang 2, huong ra phia truoc -->
  <joint name="camera_joint" type="fixed">
    <parent link="upper_deck"/>
    <child link="camera_link"/>
    <!-- x duong la phia truoc xe; z la phia tren san -->
    <origin xyz="0.17 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- Than camera va bang mach -->
  <link name="camera_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Bang mach dai 25 mm, rong 24 mm, day 8 mm -->
        <box size="0.025 0.024 0.008"/>
      </geometry>
      <material name="camera_board_green">
        <color rgba="0.05 0.35 0.12 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.024 0.008"/>
      </geometry>
    </collision>

    <!-- Khoi lens minh hoa, nhon ra phia truoc theo truc +X -->
    <visual>
      <origin xyz="0.014 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
      <material name="camera_lens_black">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.014 0 0" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.012"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.0000015"
        ixy="0"
        ixz="0"
        iyy="0.0000015"
        iyz="0"
        izz="0.0000015"/>
    </inertial>

  </link>

  <!-- Optical frame theo quy uoc ROS -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="camera_link_optical"/>

  <!-- ================================================== -->
  <!-- GAZEBO CLASSIC CAMERA SENSOR                       -->
  <!-- ================================================== -->
  <gazebo reference="camera_link">

    <material>Gazebo/Green</material>

    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>

      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>10</update_rate>

      <camera>
        <!--
          Diagonal FOV 160 degrees.
          With a 16:9 image, horizontal FOV is approximately
          157 degrees. Gazebo expects horizontal FOV in radians.
        -->
        <horizontal_fov>1.74533</horizontal_fov>

        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>

      <plugin name="camera_controller"
              filename="libgazebo_ros_camera.so">

        <ros>
          <namespace>/camera</namespace>
        </ros>

        <camera_name>ov5647</camera_name>
        <frame_name>camera_link_optical</frame_name>

      </plugin>

    </sensor>
  </gazebo>

</robot>
